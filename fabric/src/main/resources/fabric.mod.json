{
  "schemaVersion": 1,
  "id": "universalrandomizer",
  "version": "${version}",
  "name": "Universal Randomizer",
  "description": "Randomize every Minecraft gameplay system — vanilla and modded.",
  "authors": [
    "GamerBhai"
  ],
  "contact": {
    "homepage": "https://github.com/yourname/universal-randomizer",
    "sources": "https://github.com/yourname/universal-randomizer"
  },
  "license": "MIT",
  "icon": "assets/universalrandomizer/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.universalrandomizer.fabric.UniversalRandomizerFabric"
    ],
    "client": [
      "com.universalrandomizer.fabric.client.UniversalRandomizerFabricClient"
    ]
  },
  "mixins": [
    "universalrandomizer.mixins.json",
    "universalrandomizer.fabric.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.15.7",
    "fabric-api": ">=0.91.0",
    "minecraft": ">=1.20.1",
    "java": ">=17",
    "architectury": ">=9.1.12",
    "cloth-config": ">=11.1.136"
  },
  "suggests": {
    "modmenu": "*"
  }
}